{
  "name": "mattebox-player",
  "version": "0.0.0",
  "description": "Workspace for @mattebox/player-core and @mattebox/player",
  "private": true,
  "author": "Josep Boix Requesens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/mattebox-player.git"
  },
  "homepage": "https://github.com/jboix/mattebox-player#readme",
  "bugs": {
    "url": "https://github.com/jboix/mattebox-player/issues"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/player"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "verify": "npm run lint && npm run docs:check && npm run typecheck && npm run depcruise && npm run knip && npm run build && npm run check:emit && npm run check:side-effects && npx size-limit && npm run check:package && npm run test",
    "build": "npm run build --workspaces",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise packages/*/src packages/*/cdn",
    "knip": "knip",
    "test": "vitest run",
    "test:node": "vitest run --project=node",
    "test:browser": "vitest run --project=browser",
    "test:e2e": "playwright test",
    "check:emit": "node scripts/check-emit.mjs",
    "check:side-effects": "node scripts/side-effect-audit.mjs",
    "check:package": "npm run check:package --workspaces",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "docs:check": "remark . --quiet --frail --use ./scripts/remark-check-formatted.mjs",
    "docs:format": "remark . --quiet --output"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "11.0.1",
    "@size-limit/esbuild": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "mattebox": "^0.2.1",
    "playwright": "^1.62.1",
    "publint": "^0.3.24",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-validate-links": "^13.1.0",
    "rolldown": "^1.2.6",
    "semantic-release": "25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "size-limit": "^13.0.3",
    "typescript": "~5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
