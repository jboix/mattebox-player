{
  "name": "@mattebox/player-ads",
  "version": "1.0.0",
  "description": "Ads in <mattebox-player>: HLS interstitials, DASH alternative MPD, SCTE-35 cue-outs, VAST 4 and VMAP, with the ad controls and the beacons.",
  "author": "Josep Boix Requesens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/mattebox-player.git",
    "directory": "packages/ads"
  },
  "homepage": "https://github.com/jboix/mattebox-player#readme",
  "bugs": {
    "url": "https://github.com/jboix/mattebox-player/issues"
  },
  "keywords": [
    "mattebox",
    "player",
    "custom-element",
    "ads",
    "vast",
    "vmap",
    "interstitials",
    "scte-35"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/es2015/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "modern": "./dist/index.js",
      "default": "./dist/es2015/index.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "modern": "./dist/locales/*.js",
      "default": "./dist/es2015/locales/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:modern && npm run build:es2015 && npm run build:cdn",
    "build:modern": "tsc -p tsconfig.build.json --emitDeclarationOnly && rolldown -c rolldown.modern.config.mjs",
    "build:es2015": "rolldown -c rolldown.dist.config.mjs",
    "build:cdn": "rolldown -c rolldown.cdn.config.mjs",
    "check:package": "publint && attw --pack . --format table --no-emoji",
    "release:ci": "semantic-release"
  },
  "peerDependencies": {
    "@mattebox/player": ">=0.13.0",
    "mattebox": "^0.17.0"
  }
}
